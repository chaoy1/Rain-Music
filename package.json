    "pako": "^1.0.11",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "sortablejs": "^1.15.7",
    "stream-browserify": "^3.0.0",
    "tunnel": "^0.0.6",
    "undici": "^7.29.1",
    "url": "^0.11.4",
    "utf-8-validate": "^6.0.6",
    "util": "^0.12.5",
