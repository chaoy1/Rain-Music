    "node-abi": "latest",
    "minimatch": "latest",
    "semver": "latest",
    "posthtml": "latest",
    "node-gyp": "latest",
    "sockjs": {
      "uuid": "^12"
    },
    "node-gyp-build": "latest",
    "http-cache-semantics": "latest",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "bufferutil": false,
    "core-js": false,
    "electron-winstaller": false,
    "utf-8-validate": false
  }
